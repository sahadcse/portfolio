# ──────────────────────────────────────────────────────────────────────────────
# Owner dashboard + Vercel Web Analytics (server-only — never use NEXT_PUBLIC_
# for these values; never commit real secrets; .env* files are gitignored)
# See docs/visitor-analytics-setup.md for the full setup guide.
# ──────────────────────────────────────────────────────────────────────────────

# Password for the private /owner/traffic dashboard (min 8 characters).
OWNER_DASHBOARD_PASSWORD=

# Random secret used to sign the owner session cookie (min 16 characters).
# Generate e.g. with: openssl rand -base64 32
OWNER_SESSION_SECRET=

# Vercel access token with Web Analytics read scope.
# Create at: Vercel dashboard → Account Settings → Tokens
VERCEL_TOKEN=

# Vercel project id for this portfolio (prj_...).
# Shown in: Vercel dashboard → Project → Settings → General
VERCEL_PROJECT_ID=

# Only for team-owned projects — omit for personal-account projects.
VERCEL_TEAM_ID=
